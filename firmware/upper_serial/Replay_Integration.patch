diff --git a/tools/build_s20_r77207_replay.py b/tools/build_s20_r77207_replay.py
index 24d9a063..20543a38 100644
--- a/tools/build_s20_r77207_replay.py
+++ b/tools/build_s20_r77207_replay.py
@@ -49,0 +50,13 @@ def main():
+    # Shared UART debug adapter is staged with the vehicle profile so its
+    # includes resolve against the same sfType/geometry as the algorithm.
+    for name in ("UpperSerialDebug", "Lauterbach_Var", "UpperSerialReplay", "UpperSerialVariables"):
+        for extension in (".c", ".h"):
+            target = stage / "PlatformAdapter" / (name + extension)
+            shared_source = ROOT / "src" / (name + extension)
+            if not shared_source.exists():
+                continue
+            payload = source_bytes(shared_source)
+            target.write_bytes(payload)
+            hashes["PlatformAdapter/" + name + extension] = hashlib.sha256(payload).hexdigest()
+            if extension == ".c":
+                sources.append(target)
